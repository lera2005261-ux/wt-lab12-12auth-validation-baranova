@page "/Status/{code:int}"
@model StatusModel
@{
    ViewData["Title"] = "Ошибка " + Model.Code;
}

<div class="text-center py-5">
    <h1 class="display-1 fw-bold text-primary">@Model.Code</h1>
    <h4>@(Model.Code == 404 ? "Страница или товар не найдены" : "Произошла ошибка")</h4>
    <p class="text-muted">Проверьте адрес или вернитесь к списку товаров.</p>
    <a asp-page="/Products/Index" class="btn btn-primary">К списку товаров</a>
    <a asp-page="/Index" class="btn btn-outline-secondary">На главную</a>
</div>
